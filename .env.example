# ================================================================
# FORTUNEHUB BACKEND - ENVIRONMENT VARIABLES (.env)
# Copy this file and rename to .env in your project root
# ================================================================

# ----- DATABASE (Render Postgres) -----
DATABASE_URL=postgresql://username:password@host:5432/database_name
# Get this from: Render Dashboard > Your Postgres Service > Connection String (Internal)

# ----- RESEND EMAIL SERVICE -----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get this from: https://resend.com/api-keys

RESEND_FROM_EMAIL=onboarding@resend.dev
# For testing, use: onboarding@resend.dev
# For production, use your verified domain: noreply@yourdomain.com
# Verify your domain at: https://resend.com/domains

OWNER_EMAIL=your-email@example.com
# Your business email to receive order notifications

# ----- PAYSTACK PAYMENT GATEWAY -----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get this from: https://dashboard.paystack.com/#/settings/developer

# ----- SERVER CONFIG -----
PORT=3000
NODE_ENV=production

# ================================================================
# SETUP INSTRUCTIONS
# ================================================================

# 1. RENDER POSTGRES DATABASE
#    - Go to: https://dashboard.render.com
#    - Create a new PostgreSQL database
#    - Copy the "Internal Connection String"
#    - Paste it as DATABASE_URL above

# 2. RESEND EMAIL SERVICE
#    - Sign up at: https://resend.com
#    - Create an API key at: https://resend.com/api-keys
#    - For testing: use "onboarding@resend.dev"
#    - For production: Add and verify your domain at https://resend.com/domains

# 3. PAYSTACK PAYMENT
#    - Sign up at: https://paystack.com
#    - Go to: Settings > API Keys & Webhooks
#    - Copy your Secret Key (starts with sk_test_ for test mode)

# 4. OWNER EMAIL
#    - Replace with your actual business email
#    - This email will receive all order notifications

# ================================================================
# DEPLOYMENT TO RENDER
# ================================================================

# These environment variables should be added in:
# Render Dashboard > Your Web Service > Environment > Add Environment Variables

# Add each variable from above individually:
# - DATABASE_URL (automatically added when you attach Postgres)
# - RESEND_API_KEY
# - RESEND_FROM_EMAIL
# - OWNER_EMAIL
# - PAYSTACK_SECRET_KEY
# - NODE_ENV=production
# - PORT=3000 (optional, Render sets this automatically)

# ================================================================
# RESEND EMAIL SETUP GUIDE
# ================================================================

# STEP 1: Create Resend Account
# - Go to https://resend.com and sign up
# - Verify your email address

# STEP 2: Get API Key
# - Navigate to https://resend.com/api-keys
# - Click "Create API Key"
# - Give it a name (e.g., "FortuneHub Production")
# - Select "Sending access" permission
# - Copy the generated key (starts with re_)

# STEP 3: Configure Sender Email
# FOR TESTING (Quick Start):
#   Use: onboarding@resend.dev
#   No verification needed, works immediately
#   Limited to 100 emails/day

# FOR PRODUCTION (Recommended):
#   1. Go to https://resend.com/domains
#   2. Click "Add Domain"
#   3. Enter your domain (e.g., yourdomain.com)
#   4. Add the DNS records provided by Resend to your domain registrar
#   5. Wait for verification (usually 1-24 hours)
#   6. Use: noreply@yourdomain.com or orders@yourdomain.com

# STEP 4: Test Email Sending
# Send a POST request to your backend:
# POST https://your-backend-url.onrender.com/api/test-email
# Body: { "testEmail": "your-email@example.com" }

# ================================================================
# TROUBLESHOOTING
# ================================================================

# If emails are not sending:
# 1. Check RESEND_API_KEY is correct (starts with re_)
# 2. Verify RESEND_FROM_EMAIL format:
#    - For testing: onboarding@resend.dev
#    - For production: must match verified domain
# 3. Check Resend logs: https://resend.com/logs
# 4. Ensure you're not exceeding rate limits (100/day for test domain)

# If database connection fails:
# 1. Verify DATABASE_URL is the "Internal Connection String" from Render
# 2. Ensure SSL is enabled (already configured in server.js)
# 3. Check database status in Render dashboard

# If Paystack verification fails:
# 1. Use sk_test_ key for testing
# 2. Use sk_live_ key for production
# 3. Verify key is active in Paystack dashboard
