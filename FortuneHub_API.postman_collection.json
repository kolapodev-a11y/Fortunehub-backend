              "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"description\": \"Latest Apple flagship smartphone\",\n  \"price\": 500000,\n  \"category\": \"electronics\",\n  \"stock\": 10,\n  \"tags\": [\"smartphone\", \"apple\", \"5g\"]\n}"
