        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"+2348012345678\",\n    \"address\": {\n      \"street\": \"123 Main Street\",\n      \"city\": \"Lagos\",\n      \"state\": \"Lagos\",\n      \"zipCode\": \"100001\",\n      \"country\": \"Nigeria\"\n    }\n  },\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 2\n    }\n  ],\n  \"shippingCost\": 2000,\n  \"notes\": \"Please deliver between 9AM-5PM\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderStatus\": \"processing\",\n  \"note\": \"Payment confirmed, preparing shipment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders/:id/status",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", ":id", "status"],
              "variable": [{"key": "id", "value": ""}]
            }
          }
        }
